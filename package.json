{
  "name": "mytasklists",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema de listas de compras compartidas con productos recurrentes y sincronizaci\u00f3n en tiempo real",
  "workspaces": [
    "packages/contracts",
    "apps/backend",
    "apps/frontend",
    "apps/dashboard",
    "apps/landing",
    "e2e"
  ],
  "scripts": {
    "i18n:check": "node scripts/i18n-check.mjs",
    "test:i18n": "node --test scripts/test-i18n-check.mjs",
    "test:auth-locales": "npm run build --workspace @lista/backend && node --test scripts/test-google-auth.cjs scripts/test-backend-locales.mjs",
    "up": "docker compose up -d --build",
    "up:logs": "docker compose up --build",
    "down": "docker compose down",
    "down:clean": "docker compose down -v",
    "logs": "docker compose logs -f",
    "ps": "docker compose ps",
    "seed": "docker compose exec backend node dist/database/seeds/seed.js",
    "impact": "node scripts/impact.mjs",
    "contract:check": "node scripts/contract-check.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present && npm run typecheck --prefix apps/mobile",
    "test:e2e": "npm run test --workspace e2e",
    "test:e2e:report": "npm run report --workspace e2e",
    "mobile": "npm --prefix apps/mobile run start",
    "mobile:web": "npm --prefix apps/mobile run web",
    "test:e2e:backend": "npm run test:backend --workspace e2e",
    "test:e2e:frontend": "npm run test:frontend --workspace e2e",
    "test:e2e:dashboard": "npm run test:dashboard --workspace e2e",
    "test:e2e:landing": "npm run test:landing --workspace e2e",
    "test:e2e:mobile": "npm run test:mobile --workspace e2e",
    "test:maestro": "npm --prefix apps/mobile run test:maestro",
    "evidence": "npm run evidence --workspace e2e",
    "release:check": "node scripts/mobile-rollout.mjs",
    "test:rollout": "npm run build --workspace @lista/backend && node --test scripts/test-mobile-rollout.mjs",
    "test:unit": "node --test tests/backend/backend-unit-and-integration.test.mjs tests/frontend/frontend-unit-and-forms.test.mjs",
    "test:backend": "npm run build --workspace @lista/backend && node --test tests/backend/backend-unit-and-integration.test.mjs",
    "test:frontend": "node --test tests/frontend/frontend-unit-and-forms.test.mjs",
    "test:db": "node --test tests/database/database-validation.test.mjs",
    "test:database": "node --test tests/database/database-validation.test.mjs",
    "test:mobile": "node --test tests/mobile/mobile-flows.test.mjs",
    "test:gherkin": "npm run build --workspace @lista/backend && node e2e/gherkin-runner.mjs",
    "test:integration": "npm run test:gherkin",
    "test:all": "npm run test:backend && npm run test:frontend && npm run test:db && npm run test:mobile && npm run test:gherkin",
    "mobile:certs": "./scripts/generate-mobile-certs.sh",
    "mobile:certs:docker": "docker compose -f docker-compose.mobile-cert.yml up --build"
  },
  "engines": {
    "node": ">=22.12"
  },
  "overrides": {
    "typeorm": {
      "ioredis": "^6.0.0"
    }
  },
  "devDependencies": {
    "typescript": "~6.0.3"
  }
}
