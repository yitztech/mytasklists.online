# App móvil · DESARROLLO (expo start, expo run:*, pruebas en simulador).
# Apunta a la pila local de Docker (`npm run up`). En el emulador de Android el
# script de pruebas hace `adb reverse` para que localhost llegue a tu máquina.
EXPO_PUBLIC_API_URL=http://localhost:8084/api
EXPO_PUBLIC_SOCKET_URL=http://localhost:8084
