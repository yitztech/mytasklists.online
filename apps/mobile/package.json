{
  "name": "@lista/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web --port 19006",
    "export:web": "expo export --platform web --output-dir dist",
    "serve:web": "npx --yes http-server dist -p 19006 -c-1 --proxy http://localhost:19006?",
    "typecheck": "tsc --noEmit",
    "ios:release": "node ../../scripts/mobile-gate.mjs ios && expo run:ios --configuration Release --no-bundler",
    "test:maestro": "node ../../scripts/mobile-test.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@lista/contracts": "file:../../packages/contracts",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-picker/picker": "^2.11.4",
    "@react-navigation/native": "^7.5.0",
    "@react-navigation/native-stack": "^7.20.0",
    "expo": "^57.0.31",
    "expo-apple-authentication": "~57.0.2",
    "expo-asset": "~57.0.18",
    "expo-auth-session": "~57.0.16",
    "expo-constants": "~57.0.20",
    "expo-device": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-iap": "^5.8.2",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-localization": "~57.0.2",
    "expo-notifications": "~57.0.24",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.26",
    "expo-web-browser": "~57.0.3",
    "i18next": "^26.4.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^17.0.15",
    "react-native": "0.86.3",
    "react-native-nitro-google-signin": "2.3.0",
    "react-native-nitro-modules": "0.37.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@types/react": "~19.2.4",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    },
    "zod": "4.6.7"
  }
}
